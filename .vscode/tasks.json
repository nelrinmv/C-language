{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C program",
            "type": "shell",
            "command": "gcc",
            "windows": {
                "args": [
                    "-g",
                    "${file}",
                    "-o",
                    "${fileDirname}\\${fileBasenameNoExtension}.exe"
                ]
            },
            "linux": {
                "args": [
                    "-g",
                    "${file}",
                    "-o",
                    "${fileDirname}/${fileBasenameNoExtension}"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}